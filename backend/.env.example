# ============================================================
#  ESCOBAR JERSEY DESIGN APP — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to git.
# ============================================================

# ── SERVER ──────────────────────────────────────────────────
PORT=5000

# ── MONGODB ─────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/jersey_design
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/jersey_design
MONGO_URI=mongodb://localhost:27017/jersey_design

# ── JWT ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
JWT_EXPIRE=7d

# ── CLOUDINARY ──────────────────────────────────────────────
# Dashboard → https://cloudinary.com/console
# Free tier: 25GB storage / 25GB bandwidth / month
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── RAZORPAY ────────────────────────────────────────────────
# Test keys → https://dashboard.razorpay.com → Settings → API Keys
# Use "rzp_test_..." keys for local testing (no real money charged)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ── CORS ────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── SEED ADMIN ──────────────────────────────────────────────
# Used only by the seed script (scripts/seed.js)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@escobar.com
ADMIN_PASSWORD=Admin@123
